# EXPERIMENT image only (infection probe / runner research). Not the submission:
# the submitted Dockerfile installs no test packages.
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock && rm /tmp/requirements.lock
ADD https://github.com/tobymao/sqlglot/archive/eb11aec4be8cb2122afe713a4816662c3f0fb2fa.tar.gz /tmp/sqlglot.tar.gz
RUN mkdir -p /app/src && tar -xzf /tmp/sqlglot.tar.gz -C /app/src --strip-components=1 && rm /tmp/sqlglot.tar.gz \
    && python -m compileall -q /app/src/sqlglot /app/src/tests
COPY selector.py prerun.py probe.py /app/
COPY maps/ /app/maps/
RUN chmod -R a+rX /app
ENV PYTHONDONTWRITEBYTECODE=1 SKIP_INTEGRATION=0
WORKDIR /tmp
CMD ["python", "/app/selector.py"]
